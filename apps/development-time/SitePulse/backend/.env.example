# Copy to backend/.env (gitignored) and fill in. Never commit real values.

# PostgreSQL (also used by docker-compose for the database container)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sitepulse
DB_USER=sitepulse_user
DB_PASS=
# Schema owner for the database gates only: it creates the throwaway databases and
# applies migrations while DB_USER/DB_PASS serve the application as the runtime role
# (CI sets both, so row-level security applies exactly as in production). Unset means
# DB_USER/DB_PASS does both.
# DB_ADMIN_USER=sitepulse_owner
# DB_ADMIN_PASS=
# disable for local development; production requires "require" (TLS)
DB_SSLMODE=disable

# Authentication: at least 32 random characters, e.g. `openssl rand -base64 48`
SITEPULSE_JWT_SECRET=
SITEPULSE_JWT_ISSUER=sitepulse
SITEPULSE_JWT_AUDIENCE=sitepulse-api
# Run with a migration-owner connection, then start normally with a non-owner runtime role.
SITEPULSE_MIGRATIONS_ONLY=false
# Shared secret the bank uses to sign webhook bodies (X-SitePulse-Signature)
SITEPULSE_BANK_WEBHOOK_SECRET=
# Google sign-in OAuth client id (audience of Google ID tokens)
GOOGLE_CLIENT_ID=
# First SaaS administrator (created only when none exists; must change on first login)
SITEPULSE_BOOTSTRAP_ADMIN_EMAIL=admin@sitepulse.io
SITEPULSE_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated allowed CORS origins (localhost is allowed outside production)
SITEPULSE_CORS_ORIGINS=
# Environment: development | production
APP_ENV=development
# Development only: expose /api/v1/system/* demo and reset routes
SITEPULSE_ENABLE_DEV_ROUTES=false

# Kuveyt Türk sandbox integration
KT_CLIENT_ID=
KT_CLIENT_SECRET=
KT_IDENTITY_URL=
KT_GATEWAY_URL=
KT_PRIVATE_KEY_PATH=
KT_PUBLIC_KEY_PATH=
