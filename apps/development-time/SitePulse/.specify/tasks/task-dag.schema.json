{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SitePulse task DAG",
  "description": "Enforced by harness/graph/task_dag.py:validate_document (unknown dependency ids, unknown gates, malformed test ids and cycles are rejected).",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "version": {"type": "string"},
    "project": {"type": "string"},
    "schema": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "module", "status", "depends_on", "spec_ref"],
        "anyOf": [{"required": ["gates"]}, {"required": ["acceptance_tests"]}],
        "properties": {
          "id": {"type": "string", "pattern": "^task-[0-9]{2,}$"},
          "name": {"type": "string"},
          "module": {"type": "string"},
          "spec_ref": {"type": "string"},
          "description": {"type": "string"},
          "status": {"enum": ["UNVERIFIED", "PENDING", "IN_PROGRESS", "FAILED", "BLOCKED", "COMPLETED"]},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "gates": {"type": "array", "items": {"type": "string"}},
          "acceptance_tests": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(rust:[A-Za-z0-9_]+::[A-Za-z0-9_:]+|flutter:test/[A-Za-z0-9_/]+\\.dart|system:[a-z0-9_]+)$"}
          },
          "attempts": {"type": "integer", "minimum": 0},
          "max_attempts": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
